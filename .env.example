# Local development values (read by `next dev`). For `pnpm preview` (wrangler,
# port 8787) copy .dev.vars.example to .dev.vars instead.
# Production values live in Cloudflare: wrangler.jsonc "vars" + `wrangler secret put`.

NEXT_PUBLIC_APP_URL="http://localhost:3000"
BETTER_AUTH_URL="http://localhost:3000"
# openssl rand -base64 32
BETTER_AUTH_SECRET=""

# ── Google sign-in ──────────────────────────────────────────
# console.cloud.google.com → APIs & Services → Credentials → OAuth client (Web)
# Authorized redirect URI: <APP_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Stripe payments ─────────────────────────────────────────
STRIPE_SECRET_KEY=""
# Webhook endpoint: <APP_URL>/api/stripe/webhook
# Events: checkout.session.completed, checkout.session.async_payment_succeeded,
#         checkout.session.async_payment_failed, checkout.session.expired
STRIPE_WEBHOOK_SECRET=""

# ── AI companion brain ──────────────────────────────────────
ANTHROPIC_API_KEY=""

# ── Admin ───────────────────────────────────────────────────
# Comma-separated emails that can open /admin
ADMIN_EMAILS=""

# ── Development only ────────────────────────────────────────
# Enables email+password login for local dev & automated tests. NEVER in production.
AUTH_DEV_PASSWORD_LOGIN="true"
