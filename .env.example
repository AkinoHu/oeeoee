# ── Required ────────────────────────────────────────────────
# Railway: add a PostgreSQL service and reference it: ${{Postgres.DATABASE_URL}}
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/oeeoee"

# Public URL of the site (no trailing slash). Railway: https://<your-domain>
NEXT_PUBLIC_APP_URL="http://localhost:3000"
BETTER_AUTH_URL="http://localhost:3000"
# openssl rand -base64 32
BETTER_AUTH_SECRET=""

# ── Google sign-in ──────────────────────────────────────────
# console.cloud.google.com → APIs & Services → Credentials → OAuth client (Web)
# Authorized redirect URI: <APP_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Stripe payments ─────────────────────────────────────────
# dashboard.stripe.com → Developers → API keys
STRIPE_SECRET_KEY=""
# Webhook endpoint: <APP_URL>/api/stripe/webhook
# Events: checkout.session.completed, checkout.session.async_payment_succeeded,
#         checkout.session.async_payment_failed, checkout.session.expired
STRIPE_WEBHOOK_SECRET=""

# ── AI companion brain ──────────────────────────────────────
ANTHROPIC_API_KEY=""

# ── Admin ───────────────────────────────────────────────────
# Comma-separated emails that can open /admin
ADMIN_EMAILS=""

# ── Development only ────────────────────────────────────────
# Enables email+password login for local dev & automated tests. NEVER in production.
AUTH_DEV_PASSWORD_LOGIN="false"
